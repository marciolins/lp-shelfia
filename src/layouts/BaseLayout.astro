---
import CampaignTracking from "../components/CampaignTracking.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Seo from "../components/Seo.astro";
import manropeLatinUrl from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import "../styles/font.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  preloadImage?: string;
  jsonLd: Record<string, unknown>;
}

const { title, description, image, imageAlt, preloadImage, jsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-58FFD9HS");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={manropeLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          type="image/avif"
          fetchpriority="high"
        />
      )
    }
    <Seo {title} {description} {image} {imageAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-58FFD9HS"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>
    <slot name="header" />
    <main id="conteudo-principal" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <CampaignTracking />
    <ScrollReveal />
  </body>
</html>
